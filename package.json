{
  "name": "torrential",
  "version": "2.1.1",
  "description": "A torrential downpour in your terminal — search the swarm, stream instantly. torlink-inspired TUI fused with a programmatic WebTorrent streaming engine.",
  "type": "module",
  "bin": {
    "torrential": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.tsx",
    "start": "node dist/cli.js",
    "setup": "npm install && npm run build",
    "smoke": "node tools/smoke-turbo.mjs",
    "test": "node tools/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke",
    "doctor": "node dist/cli.js --doctor",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "torrent",
    "webtorrent",
    "streaming",
    "tui",
    "cli",
    "ink",
    "search",
    "magnet",
    "peer-to-peer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frierens-arm/torrential.git"
  },
  "homepage": "https://github.com/frierens-arm/torrential#readme",
  "bugs": {
    "url": "https://github.com/frierens-arm/torrential/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0",
    "ink": "^5.0.1",
    "parse-torrent": "^11.0.24",
    "react": "^18.3.1",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "ip": "npm:@eggjs/ip@^2.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "utp-native@2.5.3": true,
    "bufferutil@4.1.0": true,
    "utf-8-validate@6.0.6": true,
    "node-datachannel@0.32.3": true,
    "ip-set": false
  }
}
